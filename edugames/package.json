{
  "name": "edugames",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:dist": "bun scripts/check-dist.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "dev:api": "bun run generators:build && wrangler dev -c api/wrangler.jsonc --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply edugames --local -c api/wrangler.jsonc",
    "deploy:api": "bun run generators:build && wrangler deploy -c api/wrangler.jsonc",
    "test": "bun test ./src ./api",
    "typecheck": "tsc -b",
    "generators:build": "bun scripts/build-generators.ts",
    "sim": "bun scripts/sim.ts",
    "harness:mcp": "bun scripts/harness-mcp.ts"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "excalibur": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zzfx": "^1.3.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}
