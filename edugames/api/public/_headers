# Workers Static Assets custom headers. They apply only to assets served
# directly, not to responses built by Worker code. The games site imports
# plugin modules cross-origin, so they need CORS.
/plugins/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Bundles are content-hashed (<id>.<hash>.js): cache forever.
/plugins/*.js
  Cache-Control: public, max-age=31536000, immutable

# The manifest changes on every generators deploy.
/plugins/manifest.json
  Cache-Control: public, max-age=60, must-revalidate
