{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // API Worker → https://api.games.winstondu.com. The frontend stays an assets-only Worker (../wrangler.jsonc).
  "name": "edugames-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.games.winstondu.com", "custom_domain": true }
  ],
  // Built generator plugin modules + plugins/manifest.json (bun run generators:build). /plugins/* is served
  // directly as static assets so public/_headers applies (CORS `*` for cross-origin import(), immutable
  // cache for hashed bundles). Everything else (/v1/*) falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // database_id is omitted on purpose: `wrangler deploy` provisions the D1 database on first deploy
  // and writes the id back here. Local dev (`--local`) needs no id.
  "d1_databases": [
    { "binding": "DB", "database_name": "edugames", "migrations_dir": "migrations" }
  ],
  "vars": {
    "KINDERMATH_API_BASE": "https://api.kindermath.org/v1",
    // STUB auth: demo identity the kindermath server half sends upstream until real per-user login lands.
    "KINDERMATH_DEV_USER_EMAIL": "teacher@demo-academy.test",
    // Comma-separated browser origins allowed by CORS. Override in .dev.vars for local dev.
    "ALLOWED_ORIGINS": "https://games.winstondu.com"
  },
  // Local dev: without this, wrangler rewrites request.url to the custom domain above, so the manifest
  // would point plugin entries at http://api.games.winstondu.com instead of the local API_BASE.
  "dev": { "port": 8788, "host": "localhost:8788", "upstream_protocol": "http" },
  "observability": { "enabled": true }
}
