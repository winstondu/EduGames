{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // API Worker → https://api.games.winstondu.com. The frontend stays an assets-only Worker (../wrangler.jsonc).
  "name": "edugames-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.games.winstondu.com", "custom_domain": true }
  ],
  // Built generator plugin modules + plugins/manifest.json. /plugins/* runs through the Worker first so
  // module responses get CORS headers (games import() them cross-origin).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/plugins/*"]
  },
  // database_id is omitted on purpose: `wrangler deploy` provisions the D1 database on first deploy
  // and writes the id back here. Local dev (`--local`) needs no id.
  "d1_databases": [
    { "binding": "DB", "database_name": "edugames", "migrations_dir": "migrations" }
  ],
  "vars": {
    "KINDERMATH_API_BASE": "https://api.kindermath.org/v1",
    // Comma-separated browser origins allowed by CORS. Override in .dev.vars for local dev.
    "ALLOWED_ORIGINS": "https://games.winstondu.com"
  },
  "observability": { "enabled": true }
}
