# Copy to api/.dev.vars for `bun run dev:api` (wrangler dev). Never commit .dev.vars.
# Vite dev server: the generator manifest points plugin entries at /src/generators/<id>/index.ts there.
GENERATORS_DEV_ORIGIN=http://localhost:5173
# Browser origins allowed by CORS (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STUB auth: the API logs in to kindermath as this demo account until per-user login lands.
KINDERMATH_DEV_USER_EMAIL=teacher@demo-academy.test
# Demo account password (fill in yourself; production: `wrangler secret put KINDERMATH_DEMO_PASSWORD -c api/wrangler.jsonc`).
KINDERMATH_DEMO_PASSWORD=
# Optional: salt for hashing client IPs (abuse guard). Set with `wrangler secret put` in production.
# IP_HASH_SALT=change-me
